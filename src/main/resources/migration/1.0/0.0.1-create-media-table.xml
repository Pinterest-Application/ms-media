<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="create-media-table" author="media_user">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="media"/>
            </not>
        </preConditions>

        <createTable tableName="media">
            <column name="id" type="uuid" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" primaryKeyName="pk_media_id"/>
            </column>

            <column name="object_key" type="varchar(255)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_media_object_key"/>
            </column>

            <column name="bucket_type" type="varchar(32)">
                <constraints nullable="false"/>
            </column>

            <column name="media_type" type="varchar(50)">
                <constraints nullable="false"/>
            </column>

            <column name="file_size" type="bigint">
                <constraints nullable="false"/>
            </column>

            <column name="width" type="int">
                <constraints nullable="false"/>
            </column>

            <column name="height" type="int">
                <constraints nullable="false"/>
            </column>

            <column name="original_file_name" type="varchar(255)"/>

            <column name="is_active" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>

            <column name="created_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex indexName="idx_media_object_key" tableName="media">
            <column name="object_key"/>
        </createIndex>

        <rollback>
            <dropTable tableName="media"/>
        </rollback>
    </changeSet>

</databaseChangeLog>